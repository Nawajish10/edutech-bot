# ========================================================
# AI WhatsApp Platform - Environment Variables Template
# ========================================================

# Public Application Variables (Safe for browser)
NEXT_PUBLIC_APP_NAME="AI WhatsApp Platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# MVP Authentication (Change to a strong random string in production)
AUTH_SECRET="your_production_auth_session_secret_change_me"

# Phase 2B: Google Sheets Server Data Layer (Server-Only)
GOOGLE_SHEETS_ID="your_google_spreadsheet_id_here"
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project-id.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_RSA_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Phase 2E & 2F: Meta WhatsApp Cloud API (Server-Only)
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_VERIFY_TOKEN="your_custom_webhook_verify_token"
META_ACCESS_TOKEN="your_meta_system_user_access_token"

# Phase 2N: AI Model Configuration (Server-Only: OpenRouter or OpenAI)
OPENROUTER_API_KEY="your_openrouter_api_key"
OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENAI_API_KEY="your_openai_api_key"
ANTHROPIC_API_KEY="your_anthropic_api_key"

# Optional n8n Workflow Integration
N8N_WEBHOOK_URL="https://your-n8n-instance.com/webhook/your-webhook-id"
